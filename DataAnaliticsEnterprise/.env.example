# Backend local. Copiar a .env en esta misma carpeta.
# UTF-8, formato Java Properties: CLAVE=valor, sin export ni comillas.
# Para PostgreSQL instalado en Windows, ajustar base/usuario y contraseña.
# Si la contraseña contiene una barra inversa, escribirla duplicada.
DB_URL=jdbc:postgresql://localhost:5432/data_analytics
DB_USER=data_analytics_app
DB_PASSWORD=

# HTTP local. Usar true bajo HTTPS al desplegar.
SESSION_COOKIE_SECURE=false

# Funciones opcionales, deshabilitadas inicialmente.
INVITATION_MANUAL_DELIVERY_ENABLED=false
BOOTSTRAP_ADMIN_ENABLED=false

# TC-11: habilitar solo con claves externas custodiadas; no regenerar al reiniciar.
# TIC_SECRETS_KEY_IDS=
# TIC_SECRETS_ACTIVE_KEY_ID=
# TIC_SECRETS_KEY_K1=
