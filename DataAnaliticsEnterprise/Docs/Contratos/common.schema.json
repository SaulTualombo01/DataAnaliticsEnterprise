{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:saulongo:schema:common:1",
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "response_meta": {
      "type": "object",
      "required": [
        "request_id"
      ],
      "properties": {
        "request_id": {
          "$ref": "urn:saulongo:schema:common:1#/$defs/id"
        }
      },
      "additionalProperties": true
    },
    "page_info": {
      "type": "object",
      "required": [
        "page",
        "page_size",
        "returned_count",
        "has_next"
      ],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "returned_count": {
          "type": "integer",
          "minimum": 0
        },
        "has_next": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  }
}
