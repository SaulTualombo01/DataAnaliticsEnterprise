          "$ref": "urn:saulongo:schema:common:1#/$defs/id"
        },
        "organization_id": {
          "$ref": "urn:saulongo:schema:common:1#/$defs/id"
        },
        "project_id": {
          "$ref": "urn:saulongo:schema:common:1#/$defs/id"
        },
        "asset_id": {
          "$ref": "urn:saulongo:schema:common:1#/$defs/id"
        },
        "metadata_version_id": {
          "$ref": "urn:saulongo:schema:common:1#/$defs/id"
        },
        "state": {
          "const": "QUEUED"
        },
        "submitted_at": {
          "$ref": "urn:saulongo:schema:common:1#/$defs/timestamp"
        },
        "snapshot_id": {
          "$ref": "urn:saulongo:schema:common:1#/$defs/id"
        }
      },
      "additionalProperties": true
    },
    "meta": {
      "$ref": "urn:saulongo:schema:common:1#/$defs/response_meta"
    }
  },
  "additionalProperties": true
