{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tic:m4:analitica-http:0.1.0",
  "title": "M4 Analítica — esquemas HTTP (candidato 0.1.0)",
  "description": "Esquemas de petición y respuesta de M4. Contrato candidato para revisión; datos de ejemplo sintéticos.",
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "KpiCode": {
      "type": "string",
      "enum": [
        "DQ_VALIDEZ",
        "DQ_UNICIDAD",
        "VOL_FILAS",
        "VOL_VARIACION",
        "COMP_COLUMNA",
        "COMP_ACTIVO",
        "PERF_LATENCIA_LECTURA",
        "PERF_THROUGHPUT"
      ]
    },
    "KpiCategory": {
      "type": "string",
      "enum": ["calidad", "volumen", "completitud", "rendimiento"]
    },
    "KpiStatus": {
      "type": "string",
      "enum": ["ok", "warning", "critical", "not_evaluable"]
    },
    "ExecutionState": {
      "type": "string",
      "description": "completed: lectura completa; partial: lectura incompleta, no es evaluación final; empty: sin filas.",
      "enum": ["completed", "partial", "empty"]
    },
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "rows_evaluated"],
      "properties": {
        "complete": { "type": "boolean" },
        "rows_evaluated": { "type": "integer", "minimum": 0 },
        "reason": {
          "type": ["string", "null"],
          "description": "Motivo cuando complete es false."
        }
      }
    },
    "TimeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/Timestamp" },
        "to": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "KpiEvaluateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "kpi_codes"],
      "properties": {
        "asset_id": { "$ref": "#/$defs/Uuid" },
        "kpi_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/KpiCode" }
        },
        "window": { "$ref": "#/$defs/TimeWindow" }
      }
    },
    "KpiResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kpi_code", "category", "value", "unit", "status"],
      "properties": {
        "kpi_code": { "$ref": "#/$defs/KpiCode" },
        "category": { "$ref": "#/$defs/KpiCategory" },
        "value": { "type": ["number", "null"] },
        "unit": { "type": "string" },
        "status": { "$ref": "#/$defs/KpiStatus" },
        "threshold_warning": { "type": ["number", "null"] },
        "threshold_critical": { "type": ["number", "null"] }
      }
    },
    "KpiEvaluateResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_id",
        "read_id",
        "asset_id",
        "execution_state",
        "scope",
        "evaluated_at",
        "results"
      ],
      "properties": {
        "evaluation_id": { "$ref": "#/$defs/Uuid" },
        "read_id": {
          "$ref": "#/$defs/Uuid",
          "description": "Recibo de la lectura TC13 de la que provienen los valores."
        },
        "asset_id": { "$ref": "#/$defs/Uuid" },
        "execution_state": { "$ref": "#/$defs/ExecutionState" },
        "scope": { "$ref": "#/$defs/Scope" },
        "evaluated_at": { "$ref": "#/$defs/Timestamp" },
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/KpiResult" }
        }
      }
    },
    "DashboardRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "widget_count"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "widget_count": { "type": "integer", "minimum": 0 }
      }
    },
    "LatestKpi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kpi_code", "value", "unit", "status", "scope_complete", "evaluated_at"],
      "properties": {
        "kpi_code": { "$ref": "#/$defs/KpiCode" },
        "value": { "type": ["number", "null"] },
        "unit": { "type": "string" },
        "status": { "$ref": "#/$defs/KpiStatus" },
        "scope_complete": { "type": "boolean" },
        "evaluated_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "DashboardSummaryResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "generated_at", "execution_state", "dashboards", "latest_kpis"],
      "properties": {
        "project_id": { "$ref": "#/$defs/Uuid" },
        "generated_at": { "$ref": "#/$defs/Timestamp" },
        "execution_state": { "$ref": "#/$defs/ExecutionState" },
        "dashboards": {
          "type": "array",
          "items": { "$ref": "#/$defs/DashboardRef" }
        },
        "latest_kpis": {
          "type": "array",
          "items": { "$ref": "#/$defs/LatestKpi" }
        }
      }
    },
    "ReportFormat": {
      "type": "string",
      "enum": ["pdf", "xlsx", "csv"]
    },
    "ReportGenerateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dashboard_id", "format"],
      "properties": {
        "dashboard_id": { "$ref": "#/$defs/Uuid" },
        "format": { "$ref": "#/$defs/ReportFormat" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "ReportJobStatus": {
      "type": "string",
      "enum": ["queued", "running", "completed", "failed"]
    },
    "ReportGenerateResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "status", "format", "requested_at"],
      "properties": {
        "job_id": { "$ref": "#/$defs/Uuid" },
        "status": { "$ref": "#/$defs/ReportJobStatus" },
        "format": { "$ref": "#/$defs/ReportFormat" },
        "requested_at": { "$ref": "#/$defs/Timestamp" },
        "includes_partial_data": {
          "type": "boolean",
          "description": "true si el reporte incluirá evaluaciones parciales."
        }
      }
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "unauthenticated",
        "forbidden",
        "not_found",
        "validation_error",
        "source_unavailable",
        "internal_error"
      ]
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "$ref": "#/$defs/ErrorCode" },
            "message": { "type": "string" },
            "request_id": { "type": "string" }
          }
        }
      }
    }
  }
}
