{
  "openapi": "3.1.1",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "M4 Analítica — API HTTP",
    "version": "0.2.0",
    "description": "Contrato candidato para revisión. Éxito: envoltura {data, meta} del tronco común. Errores: application/problem+json con code y request_id. Esquemas en analitica-http.schema.json; ejemplos sintéticos en analitica.examples.json."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Backend Spring Boot local"
    },
    {
      "url": "http://127.0.0.1:8094",
      "description": "Mock M4 (tools/mock_m4.py)"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/api/v1/analitica/ping": {
      "get": {
        "operationId": "pingAnalitica",
        "summary": "Prueba de vida del módulo M4",
        "responses": {
          "200": {
            "description": "Módulo operativo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "analitica-http.schema.json#/$defs/PingEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          }
        }
      }
    },
    "/api/v1/projects/{projectId}/analytics/kpis/evaluate": {
      "post": {
        "operationId": "evaluarKpis",
        "summary": "Evaluar KPIs sobre un activo",
        "description": "Calcula los KPIs solicitados, incluido TICKET_PROMEDIO (categoría comercial). Revisar data.execution_state y data.scope.complete: un resultado parcial no es una evaluación final. data.read_id es null mientras TC13 no esté integrado.",
        "security": [
          {
            "sessionCookie": [],
            "csrf": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "analitica-http.schema.json#/$defs/KpiEvaluateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evaluación (completa, parcial o vacía).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "analitica-http.schema.json#/$defs/KpiEvaluateEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/v1/projects/{projectId}/analytics/dashboards/summary": {
      "get": {
        "operationId": "resumenDashboards",
        "summary": "Resumen de dashboards y serie temporal de KPIs del proyecto",
        "description": "data.latest_kpis es una serie temporal: varias entradas por kpi_code ordenadas por evaluated_at ascendente.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "Resumen del proyecto.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "analitica-http.schema.json#/$defs/DashboardSummaryEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/v1/projects/{projectId}/analytics/reports/generate": {
      "post": {
        "operationId": "generarReporte",
        "summary": "Solicitar la generación asíncrona de un reporte ejecutivo",
        "security": [
          {
            "sessionCookie": [],
            "csrf": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "analitica-http.schema.json#/$defs/ReportGenerateRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Trabajo aceptado; el reporte se genera de forma asíncrona.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "analitica-http.schema.json#/$defs/ReportGenerateEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ProjectId": {
        "name": "projectId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "Unauthenticated": {
        "description": "Sin sesión válida (code AUTHENTICATION_REQUIRED).",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "analitica-http.schema.json#/$defs/Problem"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Sin permiso de analítica en el proyecto o CSRF inválido (code ACCESS_DENIED o CSRF_INVALID). No revela si el recurso existe.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "analitica-http.schema.json#/$defs/Problem"
            }
          }
        }
      },
      "InvalidRequest": {
        "description": "Petición inválida (code INVALID_REQUEST).",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "analitica-http.schema.json#/$defs/Problem"
            }
          }
        }
      },
      "Unavailable": {
        "description": "Analítica o su fuente de datos no disponible (code ANALYTICS_UNAVAILABLE).",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "analitica-http.schema.json#/$defs/Problem"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "TICSESSION",
        "description": "Cookie de sesión del servidor (ver autenticacion.openapi.json)."
      },
      "csrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-TOKEN",
        "description": "Obtener con GET /api/v1/auth/csrf. Requerido en peticiones que modifican estado."
      }
    }
  }
}
