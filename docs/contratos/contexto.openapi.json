          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "inactive"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "created_at"
        ],
        "additionalProperties": false
      },
