      "properties": {
        "code": {
          "enum": [
            "GESTOR_CATALOGO",
            "ANALISTA_CALIDAD",
            "RESPONSABLE_GOBIERNO",
            "ANALISTA_NEGOCIO"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "required": [
        "code",
        "name",
        "permissions"
      ],
      "additionalProperties": false
    },
    "Assignment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
