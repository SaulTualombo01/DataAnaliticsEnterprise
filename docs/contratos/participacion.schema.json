        },
        "role_code": {
          "enum": [
            "GESTOR_CATALOGO",
            "ANALISTA_CALIDAD",
            "RESPONSABLE_GOBIERNO",
            "ANALISTA_NEGOCIO"
          ]
        },
        "status": {
