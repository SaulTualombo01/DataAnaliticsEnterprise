{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tic:participacion-proyectos:1.1.0",
  "$defs": {
    "Problem": {
      "type": "object",
      "properties": {
        "type": {
          "const": "about:blank"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "detail": {
          "type": "string"
        },
        "instance": {
          "type": "string",
          "format": "uri"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z_]+$"
        },
        "request_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "detail",
        "instance",
        "code",
        "request_id"
      ],
      "additionalProperties": false
    },
    "User": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "description": "Correo ASCII; servidor elimina espacios exteriores y normaliza a minúsculas; local-part máximo64, sin puntos consecutivos o exteriores."
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "active",
            "inactive"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "id",
        "email",
        "display_name",
        "status",
        "created_at"
      ],
      "additionalProperties": false
    },
    "AccountDetail": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "#/$defs/User"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "Entero JSON sin decimales ni conversión desde texto; obtenido del detalle actual."
        }
      },
      "required": [
        "account",
        "revision"
      ],
      "additionalProperties": false
    },
    "AccountDetailResponse": {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/AccountDetail"
        },
        "meta": {
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "request_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "data",
        "meta"
      ],
      "additionalProperties": false
    },
    "Project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "organization_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "inactive",
            "archived"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "id",
        "organization_id",
        "name",
        "status",
        "created_at"
      ],
      "additionalProperties": false
    },
    "Scope": {
      "type": "object",
      "properties": {
        "resource_scope": {
          "enum": [
            "PROJECT",
            "SOURCE",
            "ASSET"
          ]
        },
        "resource_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "resource_scope",
        "resource_id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "resource_scope": {
                "const": "PROJECT"
              }
            }
          },
          "then": {
            "properties": {
              "resource_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "resource_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          }
        }
      ]
    },
    "ScopeRequest": {
      "type": "object",
      "properties": {
        "resource_scope": {
          "enum": [
            "PROJECT",
            "SOURCE",
            "ASSET"
          ]
        },
        "resource_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "resource_scope"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "resource_scope": {
                "const": "PROJECT"
              }
            }
          },
          "then": {
            "properties": {
              "resource_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "resource_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            },
            "required": [
              "resource_id"
            ]
          }
        }
      ]
    },
    "ReasonRequest": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    },
    "MemberRequest": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        }
      },
      "required": [
        "user_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "ProjectEditRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "Entero JSON sin decimales ni conversión desde texto; obtenido del detalle actual."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        }
      },
      "required": [
        "name",
        "expected_revision",
        "reason"
      ],
      "additionalProperties": false
    },
    "StateRequest": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "Entero JSON sin decimales ni conversión desde texto; obtenido del detalle actual."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        }
      },
      "required": [
        "expected_revision",
        "reason"
      ],
      "additionalProperties": false
    },
    "SelectRequest": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "project_id"
      ],
      "additionalProperties": false
    },
    "RoleRequest": {
      "type": "object",
      "properties": {
        "role_code": {
          "enum": [
            "GESTOR_CATALOGO",
            "ANALISTA_CALIDAD",
            "RESPONSABLE_GOBIERNO",
            "ANALISTA_NEGOCIO"
          ]
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ScopeRequest"
          }
        },
        "expected_assignment_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        }
      },
      "required": [
        "role_code",
        "scopes",
        "expected_assignment_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "CompanyMember": {
      "type": "object",
      "properties": {
