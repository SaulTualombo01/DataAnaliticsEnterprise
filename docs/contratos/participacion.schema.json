        "project_id",
        "project_name",
        "project_status",
        "membership_id",
        "role_code"
      ],
      "additionalProperties": false
    },
    "Permission": {
      "type": "object",
      "properties": {
        "permission": {
          "type": "string",
          "maxLength": 200
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
