          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "assigned_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "revoked_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Scope"
          }
        }
      },
      "required": [
        "id",
        "user_id",
        "project_id",
        "membership_id",
        "role_code",
        "status",
        "assigned_by",
        "assigned_at",
        "revoked_at",
        "scopes"
      ],
      "additionalProperties": false
    },
    "ManagedProject": {
      "type": "object",
      "properties": {
