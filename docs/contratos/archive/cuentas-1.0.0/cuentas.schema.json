{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tic:cuentas-invitaciones:1.0.0",
  "$defs": {
    "InviteRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "description": "Correo ASCII; servidor elimina espacios exteriores y normaliza a minúsculas; local-part máximo64, sin puntos consecutivos o exteriores."
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        }
      },
      "required": [
        "email",
        "display_name",
        "reason"
      ],
      "additionalProperties": false
    },
    "AcceptRequest": {
      "type": "object",
      "properties": {
        "activation_token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "description": "Token opaco de 256 bits, Base64 URL sin padding. Nunca registrar ni incluir en URL/query."
        },
        "new_password": {
          "type": "string",
          "minLength": 15,
          "maxLength": 72,
          "x-max-utf8-bytes": 72,
          "description": "Mínimo15 puntos de código, máximo72 bytes UTF-8 por bcrypt. Sin recortes ni normalización. El servidor valida el límite en bytes."
        }
      },
      "required": [
        "activation_token",
        "new_password"
      ],
      "additionalProperties": false
    },
    "ReasonRequest": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    },
    "User": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "description": "Correo ASCII; servidor elimina espacios exteriores y normaliza a minúsculas; local-part máximo64, sin puntos consecutivos o exteriores."
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "active",
            "inactive"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "id",
        "email",
        "display_name",
        "status",
        "created_at"
      ],
      "additionalProperties": false
    },
    "Invitation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "organization_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "description": "Correo ASCII; servidor elimina espacios exteriores y normaliza a minúsculas; local-part máximo64, sin puntos consecutivos o exteriores."
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "invited_by": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "status": {
          "enum": [
            "pending",
            "expired",
            "accepted",
            "revoked"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "accepted_user_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "organization_id",
        "email",
        "display_name",
        "invited_by",
        "status",
        "created_at",
        "expires_at",
        "accepted_user_id"
      ],
      "additionalProperties": false
    },
    "Delivery": {
      "type": "object",
      "properties": {
        "invitation": {
          "$ref": "#/$defs/Invitation"
        },
        "delivery_mode": {
          "const": "manual"
        },
        "activation_token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "description": "Token opaco de 256 bits, Base64 URL sin padding. Nunca registrar ni incluir en URL/query."
        }
      },
      "required": [
        "invitation",
        "delivery_mode",
        "activation_token"
      ],
      "additionalProperties": false
    },
    "UserResponse": {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/User"
        },
        "meta": {
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "request_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "data",
        "meta"
      ],
      "additionalProperties": false
    },
    "DeliveryResponse": {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/Delivery"
        },
        "meta": {
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "request_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "data",
        "meta"
      ],
      "additionalProperties": false
    },
    "UserList": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/User"
          },
          "maxItems": 100
        },
        "meta": {
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "page_info": {
              "type": "object",
              "properties": {
                "page": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "page_size": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "returned_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "has_next": {
                  "type": "boolean"
                }
              },
              "required": [
                "page",
                "page_size",
                "returned_count",
                "has_next"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "request_id",
            "page_info"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "data",
        "meta"
      ],
      "additionalProperties": false
    },
    "InvitationList": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Invitation"
          },
          "maxItems": 100
        },
        "meta": {
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "page_info": {
              "type": "object",
              "properties": {
                "page": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "page_size": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "returned_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "has_next": {
                  "type": "boolean"
                }
              },
              "required": [
                "page",
                "page_size",
                "returned_count",
                "has_next"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "request_id",
            "page_info"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "data",
        "meta"
      ],
      "additionalProperties": false
    },
    "Problem": {
      "type": "object",
      "properties": {
        "type": {
          "const": "about:blank"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "detail": {
          "type": "string"
        },
        "instance": {
          "type": "string",
          "format": "uri"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z_]+$"
        },
        "request_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "detail",
        "instance",
        "code",
        "request_id"
      ],
      "additionalProperties": false
    }
  }
}
