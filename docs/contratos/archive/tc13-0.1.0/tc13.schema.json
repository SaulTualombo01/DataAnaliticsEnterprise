{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TC13 candidato 0.1.0",
  "$defs": {
    "ReadRequest": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "metadata_version_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "field_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        },
        "mode": {
          "enum": [
            "live",
            "capture"
          ]
        },
        "max_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10485760
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      },
      "required": [
        "asset_id",
        "metadata_version_id",
        "field_ids",
        "mode",
        "max_rows",
        "max_bytes",
        "timeout_ms"
      ],
      "additionalProperties": false
    },
    "Cell": {
      "type": "object",
      "properties": {
        "field_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "state": {
          "enum": [
            "VALUE",
            "NULL",
            "MISSING",
            "PARSE_ERROR"
          ]
        },
        "raw_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "field_id",
        "state",
        "raw_value"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "NULL",
                  "MISSING"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "raw_value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "VALUE",
                  "PARSE_ERROR"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "raw_value": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "Row": {
      "type": "object",
      "properties": {
        "row_number": {
          "type": "integer",
          "minimum": 1
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Cell"
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "row_number",
        "values"
      ],
      "additionalProperties": false
    },
    "Capture": {
      "type": "object",
      "properties": {
        "capture_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "organization_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "project_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "source_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "asset_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "metadata_version_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "field_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "representation": {
          "const": "raw_cells_v1"
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "capture_id",
        "organization_id",
        "project_id",
        "source_id",
        "asset_id",
        "metadata_version_id",
        "field_ids",
        "created_at",
        "expires_at",
        "content_hash",
        "representation",
        "row_count"
      ],
      "additionalProperties": false
    },
    "ReadReceipt": {
      "type": "object",
      "properties": {
        "read_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "execution_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "origin_request_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "organization_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "project_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "source_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "asset_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "metadata_version_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "field_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "mode": {
          "enum": [
            "live",
            "capture"
          ]
        },
        "execution_state": {
          "enum": [
            "COMPLETED",
            "FAILED"
          ]
        },
        "scope": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "asset"
            },
            "complete": {
              "type": "boolean"
            },
            "partial_reason": {
              "enum": [
                null,
                "ROW_LIMIT",
                "BYTE_LIMIT",
                "TIMEOUT",
                "SOURCE_INCOMPLETE"
              ]
            }
          },
          "required": [
            "kind",
            "complete",
            "partial_reason"
          ],
          "additionalProperties": false
        },
        "counts": {
          "type": "object",
          "properties": {
            "returned_rows": {
              "type": "integer",
              "minimum": 0
            },
            "expected_rows": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "serialized_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "coverage_ratio": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "returned_rows",
            "expected_rows",
            "serialized_bytes",
            "coverage_ratio"
          ],
          "additionalProperties": false
        },
        "capture": {
          "anyOf": [
            {
              "$ref": "#/$defs/Capture"
            },
            {
              "type": "null"
            }
          ]
        },
        "representation": {
          "const": "raw_cells_v1"
        }
      },
      "required": [
        "read_id",
        "execution_id",
        "origin_request_id",
        "organization_id",
        "project_id",
        "source_id",
        "asset_id",
        "metadata_version_id",
        "field_ids",
        "observed_at",
        "mode",
        "execution_state",
        "scope",
        "counts",
        "capture",
        "representation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "live"
              }
            }
          },
          "then": {
            "properties": {
              "capture": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution_state": {
                "const": "COMPLETED"
              }
            }
          },
          "then": {
            "properties": {
              "scope": {
                "properties": {
                  "complete": {
                    "const": true
                  },
                  "partial_reason": {
                    "type": "null"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution_state": {
                "const": "FAILED"
              }
            }
          },
          "then": {
            "properties": {
              "capture": {
                "type": "null"
              },
              "scope": {
                "properties": {
                  "complete": {
                    "const": false
                  },
                  "partial_reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "capture"
              },
              "execution_state": {
                "const": "COMPLETED"
              }
            }
          },
          "then": {
            "properties": {
              "capture": {
                "$ref": "#/$defs/Capture"
              }
            }
          }
        }
      ]
    },
    "ReadResponse": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "read": {
              "$ref": "#/$defs/ReadReceipt"
            },
            "records": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Row"
              },
              "maxItems": 10000
            }
          },
          "required": [
            "read",
            "records"
          ],
          "additionalProperties": false
        },
        "meta": {
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "request_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "data",
        "meta"
      ],
      "additionalProperties": false
    },
    "ReceiptResponse": {
      "type": "object",
      "properties": {
        "data": {
          "$ref": "#/$defs/ReadReceipt"
        },
        "meta": {
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "request_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "data",
        "meta"
      ],
      "additionalProperties": false
    },
    "CaptureResponse": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "capture": {
              "$ref": "#/$defs/Capture"
            },
            "records": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Row"
              },
              "maxItems": 10000
            }
          },
          "required": [
            "capture",
            "records"
          ],
          "additionalProperties": false
        },
        "meta": {
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "request_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "data",
        "meta"
      ],
      "additionalProperties": false
    },
    "Problem": {
      "type": "object",
      "properties": {
        "type": {
          "const": "about:blank"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "detail": {
          "type": "string"
        },
        "instance": {
          "type": "string",
          "format": "uri"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z_]+$"
        },
        "request_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "detail",
        "instance",
        "code",
        "request_id"
      ],
      "additionalProperties": false
    }
  }
}
